# ==============================================================================
# Environment Configuration Template
# Copy this file to '.env' and modify credentials for local or production use.
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=supersecurepasswordchangeit
POSTGRES_DB=production_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Application Database Connection URL (used by FastAPI)
DATABASE_URL=postgresql://postgres:supersecurepasswordchangeit@db:5432/production_db

# Redis Connection URL
REDIS_URL=redis://redis:6379/0
